{
    "name": "SS_ConvNeXt_HSI_V2_pruned_KD",
    "n_gpu": 1,
    "bf16": true,

    "arch": {
        "type": "SS_ConvNeXt_HSI_V2",
        "args": {
        }
    },

    "grad_clip": true,
    "grad_clip_val": 1.0,

    "grad_accum_steps": 2,

    "optimizer": {
        "type": "AdamW",
        "args":{
            "lr": 1e-4
        }
    },

    "loss": "smooth_cross_entropy_loss",
    "metrics": [
        "OA", "AA"
    ],

    "warmup": true,
    "warmup_scheduler": {
        "type": "LinearLR",
        "args": {
            "start_factor": 0.01,
            "end_factor": 1.0,
            "total_iters": 5
        }
    },
    "lr_scheduler": {
        "type": "CosineAnnealingLR",
        "args": {
            "T_max": 15,
            "eta_min": 1e-6
        }
    },

    "trainer": {
        "epochs": 20,

        "save_dir": "saved/",
        "save_period": 1,
        "verbosity": 2,
        
        "monitor": "min val_loss",
        "early_stop": 20,

        "tensorboard": true
    }
}
